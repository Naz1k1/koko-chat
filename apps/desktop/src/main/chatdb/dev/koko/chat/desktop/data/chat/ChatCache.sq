-- 每个服务和账号使用独立数据库文件，禁止跨账号复用会话或游标。
CREATE TABLE cached_conversation (
    id TEXT NOT NULL PRIMARY KEY,
    epoch TEXT NOT NULL,
    payload TEXT NOT NULL,
    contiguous_seq INTEGER NOT NULL
);
CREATE TABLE cached_message (
    id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT NOT NULL,
    epoch TEXT NOT NULL,
    seq INTEGER NOT NULL,
    payload TEXT NOT NULL,
    UNIQUE(conversation_id, epoch, seq)
);
CREATE TABLE pending_message (
    client_msg_id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT NOT NULL,
    epoch TEXT NOT NULL,
    text TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    next_attempt_at INTEGER NOT NULL,
    status TEXT NOT NULL,
    error TEXT,
    attachment_id TEXT
);

-- 用户已实际查看但服务端尚未确认的进度；同一成员周期仅保留最大值。
CREATE TABLE pending_read (
    conversation_id TEXT NOT NULL PRIMARY KEY,
    epoch TEXT NOT NULL,
    read_seq INTEGER NOT NULL
);

conversations:
SELECT * FROM cached_conversation ORDER BY id;
conversation:
SELECT * FROM cached_conversation WHERE id=?;
putConversation:
INSERT OR REPLACE INTO cached_conversation VALUES (?, ?, ?, ?);
putMessage:
INSERT OR IGNORE INTO cached_message VALUES (?, ?, ?, ?, ?);
messageAt:
SELECT * FROM cached_message WHERE conversation_id=? AND epoch=? AND seq=?;
messages:
SELECT * FROM cached_message WHERE conversation_id=? AND epoch=? ORDER BY seq DESC LIMIT 200;
clearMessages:
DELETE FROM cached_message WHERE conversation_id=?;
advance:
UPDATE cached_conversation SET contiguous_seq=? WHERE id=? AND epoch=?;
putPending:
INSERT INTO pending_message (client_msg_id,conversation_id,epoch,text,created_at,next_attempt_at,status,error) VALUES (?, ?, ?, ?, ?, ?, 'PENDING', NULL);
pending:
SELECT * FROM pending_message ORDER BY created_at,client_msg_id;
duePending:
SELECT * FROM pending_message WHERE status='PENDING' AND next_attempt_at<=? ORDER BY created_at LIMIT 20;
removePending:
DELETE FROM pending_message WHERE client_msg_id=?;
retryPending:
UPDATE pending_message SET next_attempt_at=?,status=?,error=? WHERE client_msg_id=?;
invalidatePending:
UPDATE pending_message SET status='FAILED',error='成员周期已变更，请重新发送' WHERE conversation_id=? AND epoch<>?;

-- 只在服务端明确拒绝访问后隐藏会话，网络失败不能当作退群。
removeConversation:
DELETE FROM cached_conversation WHERE id=?;
invalidateAllPending:
UPDATE pending_message SET status='FAILED',error='已退出会话，消息未发送' WHERE conversation_id=?;
pendingById:
SELECT * FROM pending_message WHERE client_msg_id=?;

pendingReads:
SELECT * FROM pending_read;
pendingRead:
SELECT * FROM pending_read WHERE conversation_id=?;
putRead:
INSERT OR REPLACE INTO pending_read VALUES (?, ?, ?);
removeRead:
DELETE FROM pending_read WHERE conversation_id=?;
-- 计数使用所有缓存消息，不能受聊天窗口最近 200 条的展示上限影响。
messagesAfter:
SELECT * FROM cached_message WHERE conversation_id=? AND epoch=? AND seq>? ORDER BY seq;

-- 展示分页与设备连续接收游标分离；使用序号游标，避免新消息插入造成 OFFSET 漂移。
olderMessages:
SELECT * FROM cached_message WHERE conversation_id=? AND epoch=? AND seq>=? AND seq<? ORDER BY seq DESC LIMIT ?;
messagesFrom:
SELECT * FROM cached_message WHERE conversation_id=? AND epoch=? AND seq>=? ORDER BY seq;
hasMessagesBefore:
SELECT EXISTS(SELECT 1 FROM cached_message WHERE conversation_id=? AND epoch=? AND seq>=? AND seq<?);

-- 上传元数据和不可变本机副本共同保留，响应丢失后沿用同一编号。
CREATE TABLE pending_upload (
    client_msg_id TEXT NOT NULL PRIMARY KEY,
    payload TEXT NOT NULL
);
putUpload:
INSERT INTO pending_upload VALUES (?, ?);
upload:
SELECT payload FROM pending_upload WHERE client_msg_id=?;
removeUpload:
DELETE FROM pending_upload WHERE client_msg_id=?;
setAttachment:
UPDATE pending_message SET attachment_id=? WHERE client_msg_id=?;
