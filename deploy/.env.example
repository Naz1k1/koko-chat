# 仅供本机开发；复制为 deploy/.env 后填写自己的值。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=koko_chat
MYSQL_USERNAME=koko
MYSQL_PASSWORD=replace-with-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-redis-password

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=koko
RABBITMQ_PASSWORD=replace-with-local-rabbitmq-password
RABBITMQ_MANAGEMENT_PORT=15672

# RustFS S3 API 与控制台；开发环境使用随机凭证，禁止沿用默认管理员密码。
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=replace-with-local-rustfs-access-key
RUSTFS_SECRET_KEY=replace-with-local-rustfs-secret-key
RUSTFS_BUCKET=koko-chat

# 可选的本机 TURN 中继：docker compose --profile calls up -d coturn
KOKO_TURN_URLS=turn:127.0.0.1:3478?transport=udp
KOKO_TURN_SECRET=replace-with-random-shared-secret
TURN_EXTERNAL_IP=127.0.0.1
